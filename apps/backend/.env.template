# 复制为本目录下的 .env 后再改成本机值：
#   cp .env.template .env
# dev 脚本通过 --env-file=.env 加载，改完需重启进程。

# 运行环境：development | production | test（必填）
APP_ENV=development

# 监听地址（必填）。本机只给自己用填 127.0.0.1，要给局域网访问可改 0.0.0.0
HOST=127.0.0.1

# 监听端口（必填），整数 0–65535
PORT=3000

# 日志级别（必填）：debug | info | warn | error | fatal | trace | silent
LOG_LEVEL=info

# 可选。true / false。不填时：production 关闭 Swagger UI，其余环境打开
# OPENAPI_UI=true

# PostgreSQL 连接串（可选，但做 /test 落库或跑迁移时必填）
# 格式：postgres://用户名:密码@主机:端口/数据库名
# 下面与本机 Docker 示例一致：
#   docker run -d --name pg18 \
#     -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_USER=postgres \
#     -e POSTGRES_DB=postgres \
#     -p 5432:5432 \
#     postgres:18.6
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
